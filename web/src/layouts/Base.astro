---
import "../styles/global.css"
import Palette from "../components/Palette.astro"
import Logo from "../components/Logo.astro"

interface Props {
  title?: string
  description?: string
  /** Pathname of the active top-level section, used to mark the nav. */
  section?: string
  /** Full-width pages (the landing page) skip the docs rail. */
  wide?: boolean
}

const {
  title,
  description = "Native GPUI components with source you own. Explore the component catalog and the complete Lucide icon library. Experimental, built with Rust.",
  section,
} = Astro.props
const fullTitle = title ? `${title} · gpuicn` : "gpuicn — Native components. Your source code."
const canonical = new URL(Astro.url.pathname, Astro.site)
const nav = [
  { href: "/introduction/", label: "Docs", match: ["/introduction/", "/installation/", "/theming/", "/showcase/"] },
  { href: "/components/", label: "Components", match: ["/components/"] },
  { href: "/icons/", label: "Icons", match: ["/icons/"] },
  { href: "/registry/", label: "Registry", match: ["/registry/"] },
]
const current = section ?? Astro.url.pathname
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-panels.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-panels.png" />
    <link rel="preload" href="/fonts/Geist-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Geist-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="gpuicn" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://ui.imajha.com/og-gpuicn-beta.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="gpuicn beta. Native components. Your source code. Ivory and orange overlapping panels on a dark background."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://ui.imajha.com/og-gpuicn-beta.jpg" />
    <meta name="theme-color" content="#f3eee4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121010" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Runs before paint so the stored theme never flashes.
      ;(function () {
        var stored = null
        try {
          stored = localStorage.getItem("gpuicn-theme")
        } catch (_) {}
        var dark =
          stored === "dark" ||
          (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.dataset.theme = dark ? "dark" : "light"
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__row">
        <a class="brand" href="/" aria-label="gpuicn home">
          <Logo />
          <span>gpuicn</span>
        </a>
        <a class="tag tag--outline brand__status" href="/installation/#beta" aria-label="Experimental: what to expect">
          Experimental
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={item.match.some((prefix) => current.startsWith(prefix)) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="site-actions">
          <button class="search-trigger" type="button" data-open-palette aria-label="Search the site">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <span class="search-trigger__label">Search</span>
            <kbd class="search-trigger__kbd" aria-hidden="true">⌘K</kbd>
          </button>
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch color theme">
            <svg class="icon icon--sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg class="icon icon--moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
          </button>
          <a class="icon-btn" href="https://github.com/devaryakjha/gpuicn" aria-label="gpuicn on GitHub">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65S8.93 17.38 9 18v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
          <a class="btn btn--sm site-actions__cta" href="/installation/">Get started</a>
        </div>
      </div>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__row">
        <p class="mono">Built with Rust and GPUI · Open source, from the start</p>
        <nav class="site-footer__links" aria-label="Footer">
          <a href="https://github.com/devaryakjha/gpuicn">GitHub</a>
          <a href="https://github.com/devaryakjha/gpuicn/releases">Releases</a>
          <a href="https://crates.io/crates/gpuicn">crates.io</a>
          <a href="https://github.com/devaryakjha/gpui-icons">gpui-icons</a>
        </nav>
      </div>
    </footer>

    <Palette />
    <script src="../scripts/site.ts"></script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 0.375rem;
  }
  .skip:focus {
    top: 0.5rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .site-header__row {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    font-size: 1.125rem;
  }
  .brand__status {
    text-decoration: none;
  }
  .site-nav {
    display: none;
    margin-left: 1.25rem;
    gap: 0.25rem;
  }
  .site-nav a {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--ink-2);
    transition:
      color 120ms,
      background-color 120ms;
  }
  .site-nav a:hover {
    color: var(--ink);
  }
  .site-nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--paper-2);
  }
  .site-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.125rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    color: var(--ink-2);
    border: 1px solid transparent;
  }
  .search-trigger:hover {
    color: var(--ink);
    border-color: var(--rule);
  }
  .search-trigger__label,
  .search-trigger__kbd {
    display: none;
  }
  .search-trigger__kbd {
    font-size: 0.625rem;
    letter-spacing: 0.05em;
    color: var(--ink-3);
    padding: 0.1rem 0.3rem;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
  }
  .icon-btn {
    width: 2.125rem;
    height: 2.125rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--ink-2);
  }
  .icon-btn:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .icon--sun {
    display: none;
  }
  :global([data-theme="dark"]) .icon--sun {
    display: block;
  }
  :global([data-theme="dark"]) .icon--moon {
    display: none;
  }
  .site-actions__cta {
    display: none;
    margin-left: 0.5rem;
  }
  @media (min-width: 48rem) {
    .site-nav {
      display: flex;
    }
    .site-actions__cta {
      display: inline-flex;
    }
    .search-trigger__label {
      display: inline;
      font-size: 0.8125rem;
    }
    .search-trigger__kbd {
      display: inline;
    }
  }
  @media (max-width: 30rem) {
    .brand__status {
      display: none;
    }
  }

  .site-main {
    flex: 1;
  }

  .site-footer {
    border-top: 1px solid var(--rule);
    padding: 1.75rem 0;
  }
  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .site-footer__links a:hover {
    color: var(--ink);
  }
</style>
