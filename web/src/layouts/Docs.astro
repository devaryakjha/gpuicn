---
import Base from "./Base.astro"
import { components, componentHref, componentNumber, isNew, sections } from "../lib/catalog"

interface Props {
  title: string
  description?: string
  eyebrow?: string
  /** Pathname used to mark the active rail entry. */
  current?: string
  toc?: { href: string; label: string }[]
}

const { title, description, eyebrow, current = Astro.url.pathname, toc } = Astro.props
---

<Base title={title} description={description} section={current}>
  <div class="wrap docs">
    <aside class="rail">
      <button class="rail__summary" type="button" data-rail-toggle aria-expanded="false" aria-controls="rail-nav">
        <span class="mono">Index</span>
        <span class="rail__summary-title">{title}</span>
      </button>
      <nav class="rail__nav" id="rail-nav" aria-label="Documentation">
          <p class="mono rail__label">Docs</p>
          <ul class="rail__list">
            {
              sections.map((section) => (
                <li>
                  <a href={section.to} aria-current={current === section.to ? "page" : undefined}>
                    {section.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mono rail__label">
            Components <span class="rail__count">{components.length}</span>
          </p>
          <ul class="rail__list rail__list--components">
            {
              components.map((component) => (
                <li>
                  <a
                    href={componentHref(component.slug)}
                    aria-current={current === componentHref(component.slug) ? "page" : undefined}
                  >
                    <span class="rail__num">{componentNumber(component.slug)}</span>
                    {component.name}
                    {isNew(component) && <span class="tag">New</span>}
                  </a>
                </li>
              ))
            }
          </ul>
      </nav>
    </aside>

    <article class="article">
      <header class="article__head">
        {eyebrow && <p class="mono">{eyebrow}</p>}
        <h1 class="article__title">{title}</h1>
        {description && <p class="lede">{description}</p>}
        <slot name="head" />
      </header>
      <slot />
    </article>

    {
      toc && (
        <nav class="toc" aria-label="On this page">
          <p class="mono">On this page</p>
          <ul>
            {toc.map((entry) => (
              <li>
                <a href={entry.href}>{entry.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 3rem;
    padding-bottom: 5rem;
  }
  @media (min-width: 60rem) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
  }
  @media (min-width: 80rem) {
    .docs {
      grid-template-columns: 14rem minmax(0, 1fr) 11rem;
    }
  }

  .rail {
    border-bottom: 1px solid var(--rule);
  }
  .rail__summary {
    width: 100%;
    padding: 0.75rem 0;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-align: left;
  }
  .rail__summary-title {
    font-weight: 500;
    font-size: 0.9375rem;
  }
  .rail__summary::after {
    content: "";
    margin-left: auto;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid var(--ink-2);
    border-bottom: 1.5px solid var(--ink-2);
    transform: translateY(-0.15rem) rotate(45deg);
  }
  .rail__summary[aria-expanded="true"]::after {
    transform: rotate(-135deg);
  }
  .rail__nav {
    display: none;
    padding: 0.5rem 0 1rem;
  }
  .rail__summary[aria-expanded="true"] + .rail__nav {
    display: block;
  }
  .rail__label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.25rem 0 0.5rem;
  }
  .rail__label:first-child {
    padding-top: 0;
  }
  .rail__count {
    color: var(--ink-3);
  }
  .rail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
  }
  .rail__list a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 0.375rem;
    color: var(--ink-2);
  }
  .rail__list a:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .rail__list a[aria-current="page"] {
    color: var(--ink);
    background: var(--paper-2);
    font-weight: 500;
  }
  .rail__num {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
    width: 1.5rem;
  }
  .rail__list .tag {
    margin-left: auto;
  }
  @media (min-width: 60rem) {
    .rail {
      border: 0;
      position: sticky;
      top: var(--header);
      align-self: start;
      max-height: calc(100vh - var(--header));
      overflow-y: auto;
      padding: 2.5rem 0.5rem 2.5rem 0;
      scrollbar-width: thin;
    }
    .rail__summary {
      display: none;
    }
    .rail__nav {
      display: block;
      padding: 0;
    }
  }

  .article {
    min-width: 0;
    padding: 2.5rem 0 0;
    max-width: 48rem;
  }
  .article__head {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
  }
  .article__title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  @media (min-width: 60rem) {
    .article {
      padding-top: 2.5rem;
    }
  }

  .toc {
    display: none;
  }
  @media (min-width: 80rem) {
    .toc {
      display: block;
      position: sticky;
      top: var(--header);
      align-self: start;
      padding-top: 2.75rem;
    }
    .toc ul {
      list-style: none;
      margin: 0.75rem 0 0;
      padding: 0;
      font-size: 0.8125rem;
      display: grid;
      gap: 0.4rem;
    }
    .toc a {
      color: var(--ink-2);
    }
    .toc a:hover {
      color: var(--ink);
    }
  }
</style>
