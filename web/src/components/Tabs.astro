---
/**
 * A tab group. Pass `tabs` and fill one named slot per tab id. The script in
 * site.ts wires the buttons; without it the first panel stays visible.
 */
interface Props {
  tabs: { id: string; label: string }[]
  label: string
  class?: string
}
const { tabs, label, class: className } = Astro.props
const uid = Math.random().toString(36).slice(2, 8)
---

<div class:list={["tabs", className]} data-tabs>
  <div class="tabs__list" role="tablist" aria-label={label}>
    {
      tabs.map((tab, index) => (
        <button
          class="tabs__tab"
          type="button"
          role="tab"
          id={`${uid}-tab-${tab.id}`}
          aria-controls={`${uid}-panel-${tab.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    tabs.map((tab, index) => (
      <div
        class="tabs__panel"
        role="tabpanel"
        id={`${uid}-panel-${tab.id}`}
        aria-labelledby={`${uid}-tab-${tab.id}`}
        hidden={index !== 0}
        data-tab={tab.id}
      >
        <slot name={tab.id} />
      </div>
    ))
  }
</div>
