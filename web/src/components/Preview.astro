---
import { previewHeight } from "../lib/catalog"

interface Props {
  slug: string
  name: string
  icon?: string
  example?: string
  height?: number
  id?: string
}

const { slug, name, icon, example, id, height = previewHeight(slug) } = Astro.props
---

<div
  class="gpu"
  id={id}
  data-demo={slug}
  data-name={name}
  data-icon={icon}
  data-example={example}
  data-height={height}
  data-status="loading"
  style={`height:${height}px`}
>
  <div class="gpu__status" role="status">
    <span class="gpu__pulse" aria-hidden="true"></span>
    <p>
      <span data-when="loading">Starting the preview. GPUI compiles to WebAssembly, so the first load takes a few seconds.</span>
      <span data-when="unsupported">This browser has neither WebGPU nor WebGL 2, so the live preview cannot run. The code on this page still works.</span>
      <span data-when="failed">The preview did not start.</span>
    </p>
    <button class="btn" type="button" data-retry>Try again</button>
  </div>
</div>

<style>
  .gpu [data-when] {
    display: none;
  }
  .gpu[data-status="loading"] [data-when="loading"],
  .gpu[data-status="unsupported"] [data-when="unsupported"],
  .gpu[data-status="failed"] [data-when="failed"] {
    display: inline;
  }
</style>
