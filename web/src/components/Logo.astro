---
interface Props {
  size?: number
}
const { size = 26 } = Astro.props
---

<!-- Two overlapping panels: the gpuicn mark, drawn as vectors so it stays crisp in both themes. -->
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo">
  <rect x="10" y="4" width="18" height="18" rx="4" class="logo__back"></rect>
  <rect x="4" y="10" width="18" height="18" rx="4" class="logo__front"></rect>
  <rect x="8.5" y="14.5" width="9" height="9" rx="1.5" class="logo__hole"></rect>
</svg>

<style>
  .logo__back {
    fill: var(--accent);
  }
  .logo__front {
    fill: var(--ink);
  }
  .logo__hole {
    fill: var(--paper);
  }
</style>
