---
import Base from "../layouts/Base.astro"
---

<Base title="Page not found">
  <section class="wrap missing">
    <p class="mono">404</p>
    <h1 class="display missing__title">Nothing here.</h1>
    <p class="lede">The page may have moved. The catalog and the docs are one search away.</p>
    <div class="missing__actions">
      <a class="btn" href="/">Back home</a>
      <button class="btn btn--ghost" type="button" data-open-palette>Search</button>
    </div>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding: clamp(4rem, 12vw, 9rem) var(--gutter);
  }
  .missing__title {
    font-size: clamp(3rem, 9vw, 7rem);
  }
  .missing__actions {
    display: flex;
    gap: 0.75rem;
  }
</style>
