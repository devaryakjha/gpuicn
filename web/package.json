{
  "name": "gpuicn-web",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "bun run sync:static && astro dev",
    "build": "bun run sync:static && astro build",
    "sync:static": "bun ../scripts/sync-catalog.mjs && bun scripts/render-platform-notes.mjs && mkdir -p public/r && cp -R ../site/pages/r/. public/r/",
    "lint": "astro check",
    "typecheck": "astro check",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.5",
    "shiki": "^4.6.0",
    "typescript": "~6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
